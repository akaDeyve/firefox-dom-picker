{
  "name": "firefox-dom-picker",
  "description": "Firefox-Extension: Element im Browser anklicken und HTML-/CSS-Kontext als LLM-Prompt kopieren.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "web-ext lint --source-dir dist",
    "test": "npm run build && node tests/content-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run lint",
    "start": "npm run build && web-ext run --source-dir dist",
    "sign": "web-ext sign --source-dir dist --artifacts-dir web-ext-artifacts"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "web-ext": "^8.7.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
